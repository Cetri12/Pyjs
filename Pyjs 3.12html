<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Python Runner (Fixed)</title>

<style>
body{
  margin:0;
  font-family:monospace;
  background:#0b0f1a;
  color:white;
}

.header{
  padding:10px;
  background:#050814;
  border-bottom:1px solid #1e3a5f;
}

.container{
  display:flex;
  height:calc(100vh - 50px);
}

textarea{
  width:50%;
  background:#050814;
  color:white;
  border:none;
  padding:12px;
  resize:none;
  outline:none;
  font-family:monospace;
  font-size:14px;
}

.right{
  width:50%;
  display:flex;
  flex-direction:column;
  border-left:1px solid #1e3a5f;
}

.output{
  flex:1;
  padding:10px;
  overflow-y:auto;
  white-space:pre-wrap;
}

.inputBar{
  display:flex;
  border-top:1px solid #1e3a5f;
}

.inputBar input{
  flex:1;
  background:#0b0f1a;
  border:none;
  color:white;
  padding:10px;
  outline:none;
  font-family:monospace;
}

button{
  margin-right:5px;
  background:#12223a;
  color:white;
  border:1px solid #1e3a5f;
  padding:8px 14px;
  cursor:pointer;
}

button:hover{
  background:#1a3354;
}
</style>
</head>

<body>

<div class="header">
  <button onclick="run()">Run</button>
  <button onclick="clearOut()">Clear</button>
</div>

<div class="container">

<textarea id="code">
import random

print("Select die")
d = input("d6, d20, etc: ")

while True:

    r = input("Roll? y/n: ")

    if r == "y":

        sides = int(d[1:])

        print("Roll:")
        print(random.randint(1, sides))

    elif r == "n":
        break

    else:
        print("Type y or n")
</textarea>

<div class="right">

<div id="output" class="output"></div>

<div class="inputBar">
<input id="inputBox" placeholder="Input here...">
</div>

</div>
</div>

<script>

/* ================= ELEMENTS ================= */

const output =
  document.getElementById("output");

const code =
  document.getElementById("code");

const inputBox =
  document.getElementById("inputBox");

/* ================= OUTPUT ================= */

function log(s){

  output.textContent += s + "\n";

  output.scrollTop =
    output.scrollHeight;
}

function clearOut(){

  output.textContent = "";
}

/* ================= INPUT ================= */

let inputQueue = [];

let waitingResolver = null;

inputBox.onkeydown = e=>{

  if(e.key === "Enter"){

    let v = inputBox.value;

    log("> " + v);

    inputBox.value = "";

    if(waitingResolver){

      waitingResolver(v);

      waitingResolver = null;

    } else {

      inputQueue.push(v);
    }
  }
};

function input(prompt){

  if(prompt){
    log(prompt);
  }

  return new Promise(res=>{

    if(inputQueue.length > 0){

      res(inputQueue.shift());

    } else {

      waitingResolver = res;
    }
  });
}

/* ================= RUN ================= */

async function run(){

  clearOut();

  let codeStr = code.value;

  let translated =
    translate(codeStr);

  let py = `
async function __main__(){

${translated}

}

await __main__();
`;

  try{

    await eval(`
      (async()=>{

        ${py}

      })();
    `);

  } catch(e){

    log("ERROR:");
    log(e.message);

    console.error(e);
  }
}

/* ================= TRANSLATOR ================= */

function translate(src){

  let lines =
    src.split("\n");

  let out = [];

  let indentStack = [0];

  let declared = new Set();

  for(let rawLine of lines){

    if(!rawLine.trim()) continue;

    let indent =
      rawLine.match(/^ */)[0].length;

    let trimmed =
      rawLine.trim();

    /* ================= COMMENTS ================= */

    trimmed =
      trimmed.replace(/#.*$/,"");

    if(!trimmed) continue;

    /* ================= PYTHON HELPERS ================= */

    trimmed = trimmed
      .replace(/\bTrue\b/g,"true")
      .replace(/\bFalse\b/g,"false")
      .replace(/\band\b/g,"&&")
      .replace(/\bor\b/g,"||")
      .replace(/\bnot\b/g,"!");

    /* int(x) */

    trimmed = trimmed.replace(
      /\bint\((.*?)\)/g,
      "parseInt($1)"
    );

    /* float(x) */

    trimmed = trimmed.replace(
      /\bfloat\((.*?)\)/g,
      "parseFloat($1)"
    );

    /* str(x) */

    trimmed = trimmed.replace(
      /\bstr\((.*?)\)/g,
      "String($1)"
    );

    /* len(x) */

    trimmed = trimmed.replace(
      /\blen\((.*?)\)/g,
      "$1.length"
    );

    /* x[1:] -> x.slice(1) */

    trimmed = trimmed.replace(
      /(\w+)\[(\d+):\]/g,
      "$1.slice($2)"
    );

    /* ================= CLOSE BLOCKS ================= */

    while(
      indent <
      indentStack[indentStack.length-1]
    ){

      out.push("}");

      indentStack.pop();
    }

    /* ================= IMPORT RANDOM ================= */

    if(trimmed.startsWith("import random")){

      out.push(`
const random = {
  randint:(a,b)=>
    Math.floor(
      Math.random()*(b-a+1)
    ) + a
};
`);

      continue;
    }

    /* ================= PRINT ================= */

    if(trimmed.startsWith("print(")){

      let inside =
        trimmed.slice(6,-1);

      out.push(
        `log(String(${inside}));`
      );

      continue;
    }

    /* ================= WHILE ================= */

    if(trimmed.startsWith("while ")){

      let cond =
        trimmed
          .slice(6)
          .replace(/:$/,"");

      out.push(
        `while(${cond}){`
      );

      indentStack.push(indent+4);

      continue;
    }

    /* ================= IF ================= */

    if(trimmed.startsWith("if ")){

      let cond =
        trimmed
          .slice(3)
          .replace(/:$/,"");

      out.push(
        `if(${cond}){`
      );

      indentStack.push(indent+4);

      continue;
    }

    /* ================= ELIF ================= */

    if(trimmed.startsWith("elif ")){

      while(
        indent <
        indentStack[indentStack.length-1]
      ){

        out.push("}");

        indentStack.pop();
      }

      let cond =
        trimmed
          .slice(5)
          .replace(/:$/,"");

      out.push(
        `else if(${cond}){`
      );

      indentStack.push(indent+4);

      continue;
    }

    /* ================= ELSE ================= */

    if(trimmed === "else:"){

      while(
        indent <
        indentStack[indentStack.length-1]
      ){

        out.push("}");

        indentStack.pop();
      }

      out.push("else{");

      indentStack.push(indent+4);

      continue;
    }

    /* ================= BREAK ================= */

    if(trimmed === "break"){

      out.push("break;");

      continue;
    }

    /* ================= CONTINUE ================= */

    if(trimmed === "continue"){

      out.push("continue;");

      continue;
    }

    /* ================= INPUT ================= */

    if(trimmed.includes("input(")){

      if(trimmed.includes("=")){

        let eq =
          trimmed.indexOf("=");

        let left =
          trimmed.slice(0,eq);

        let right =
          trimmed.slice(eq+1);

        let varName =
          left.trim();

        let keyword =
          declared.has(varName)
          ? ""
          : "let ";

        declared.add(varName);

        out.push(
`${keyword}${varName} =
await input${right.slice(right.indexOf("("))};`
        );

      } else {

        out.push(
`await input${trimmed.slice(trimmed.indexOf("("))};`
        );
      }

      continue;
    }

    /* ================= FUNCTION ================= */

    if(trimmed.startsWith("def ")){

      let name =
        trimmed.slice(
          4,
          trimmed.indexOf("(")
        );

      let args =
        trimmed.slice(
          trimmed.indexOf("(")+1,
          trimmed.indexOf(")")
        );

      out.push(
        `function ${name}(${args}){`
      );

      indentStack.push(indent+4);

      continue;
    }

    /* ================= RETURN ================= */

    if(trimmed.startsWith("return ")){

      out.push(
        `return ${trimmed.slice(7)};`
      );

      continue;
    }

    /* ================= ASSIGNMENT ================= */

    if(
      trimmed.includes("=") &&
      !trimmed.includes("==") &&
      !trimmed.includes(">=") &&
      !trimmed.includes("<=") &&
      !trimmed.includes("!=")
    ){

      let eq =
        trimmed.indexOf("=");

      let left =
        trimmed.slice(0,eq);

      let right =
        trimmed.slice(eq+1);

      let varName =
        left.trim();

      let keyword =
        declared.has(varName)
        ? ""
        : "let ";

      declared.add(varName);

      out.push(
`${keyword}${varName} =
${right.trim()};`
      );

      continue;
    }

    /* ================= OTHER ================= */

    out.push(trimmed + ";");
  }

  /* ================= CLOSE BLOCKS ================= */

  while(indentStack.length > 1){

    out.push("}");

    indentStack.pop();
  }

  return out.join("\n");
}

</script>

</body>
</html>